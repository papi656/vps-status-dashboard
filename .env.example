# --- Ingest sink / dashboard ---
INGEST_TOKEN=dev
# Agent posts to http://127.0.0.1:8099/ingest by default.
HOST=0.0.0.0
PORT=8099

# --- Storage ---
DATA_DIR=./data
# DB_PATH=./data/status.db
# Hours of 60s samples to keep.
SAMPLE_RETENTION_HOURS=24
# Days of 12h disk-space scans to keep.
SCAN_RETENTION_DAYS=7
