# --- Ingest auth ---
# REQUIRED. Shared secret with the agent's TOKEN. Generate with:
#   openssl rand -hex 32
# The app refuses to start if this is empty; it warns if left at 'dev'.
INGEST_TOKEN=dev

# --- Listeners ---
HOST=0.0.0.0
# Public surface: UI + read-only API. The reverse proxy routes this.
# Not called PORT on purpose: platforms inject a generic PORT for their own routing.
PUBLIC_PORT=8098
# Ingest surface: /ingest only. Publish to host loopback; never route it.
# 8099 matches the serverStatus agent's built-in ENDPOINT, so the agent needs no change.
INGEST_PORT=8099

# --- Ingest hardening (see README) ---
# Minimum seconds between accepted snapshots. 0 disables the limit (for seeding).
INGEST_RATE_LIMIT_SECONDS=30
# Reject ingest bodies larger than this (bytes).
MAX_INGEST_BODY_BYTES=1048576
# Allowed clock skew between agent and dashboard (seconds).
CLOCK_SKEW_SECONDS=300
# Expose /docs and /openapi.json on the public surface (off by default).
# ENABLE_DOCS=1

# --- Storage ---
DATA_DIR=./data
# DB_PATH=./data/status.db
# Hours of 60s samples to keep.
SAMPLE_RETENTION_HOURS=24
# Days of 12h disk-space scans to keep.
SCAN_RETENTION_DAYS=7
# How often the background retention task runs (seconds), independent of ingest.
PRUNE_INTERVAL_SECONDS=300
